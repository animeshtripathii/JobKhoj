# Git/version control
.git
.gitignore

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info

# Virtual environments
venv/
env/
.venv/

# Local data (resume + FAISS index are stored in Docker volume at runtime)
data/resume/*.pdf
data/faiss_index/*.index
data/faiss_index/*.json

# Local SQLite DB (replaced by Neon PostgreSQL in production)
app_tracker.db

# Environment secrets (injected via docker-compose env_file)
.env

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
